{
  "name": "dtabs-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade Multi-Tenant SaaS E-Commerce Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=apps/api"
  },
  "keywords": [
    "multi-tenant",
    "ecommerce",
    "saas",
    "nextjs",
    "express",
    "mongodb"
  ],
  "author": "DTabs",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
