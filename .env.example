# ===================================================
# DTabs Commerce Environment Configuration
# ===================================================

# Platform & Server
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
PLATFORM_DOMAIN=dtabs.tech
NEXT_PUBLIC_PLATFORM_DOMAIN=dtabs.tech
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-dtabs-commerce-production-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-dtabs-commerce-change-me
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=super-secret-cookie-signing-key-change-me
WEBHOOK_SIGNING_SECRET=whsec_dtabs_sample_secret_key_change_me

# Database & Cache
# Leave blank or set in dev; if not reachable, app uses built-in resilient in-memory mode
MONGODB_URI=mongodb://127.0.0.1:27017/dtabs_commerce
REDIS_URL=redis://127.0.0.1:6379

# Storage (AWS S3 / Cloudflare R2 / Local Disk fallback)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Payments
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_key
DODO_PAYMENTS_API_KEY=dodo_api_key_placeholder
DODO_PAYMENTS_WEBHOOK_SECRET=dodo_whsec_placeholder

# Logging
LOG_LEVEL=debug
